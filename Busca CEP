import java.net.URL;
import java.util.Scanner;

public class BCIniciante {

	public static void main(String[] args) throws Exception {
		Scanner sca = new Scanner (System.in);
		
		System.out.print("Digite o CEP (Apenas números): ");
		String cep = sca.nextLine();
		
		String urlString = "https://viacep.com.br/ws/" + cep + "/json/";
		
		URL url = new URL(urlString);
		Scanner leitorApi = new Scanner(url.openStream());
		
		System.out.println("\nResultado na busca: ");
		
		while (leitorApi.hasNextLine()) {
			System.out.println(leitorApi.nextLine());
		}
		
		leitorApi.close();
		sca.close();

	}

}
